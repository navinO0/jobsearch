# Nginx Reverse Proxy Configuration for Next.js and n8n
# Production deployment

upstream nextjs_app {
    server 127.0.0.1:3000;
    keepalive 32;
}

upstream n8n_service {
    server 10.0.3.6:5678;
    keepalive 32;
}

# HTTP to HTTPS redirect
server {
    listen 80;
    server_name jobs.navin.lol;
    return 301 https://$host$request_uri;
}

# Production SSL Virtual Host
server {
    listen 443 ssl http2;
    server_name jobs.navin.lol;

    # SSL Certificates
    ssl_certificate /etc/letsencrypt/live/jobs.navin.lol/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/jobs.navin.lol/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    client_max_body_size 50M;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Next.js Application UI & BFF API
    location / {
        proxy_pass http://nextjs_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # n8n Webhook Ingress
    location /webhook/ {
        proxy_pass http://n8n_service/webhook/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_connect_timeout 60s;
    }
}
