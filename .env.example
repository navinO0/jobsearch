# 1. DATABASE (PostgreSQL 16)
DATABASE_HOST=10.0.3.3
DATABASE_PORT=5432
DATABASE_NAME=n8n
DATABASE_USER=UZ2Dd4tp4eVRsS22
DATABASE_PASSWORD=your_secure_db_password
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# 2. NEXTAUTH / AUTH & SECURITY
NEXTAUTH_URL=https://jobs.example.com
NEXTAUTH_SECRET=your_long_random_nextauth_secret_key_32_bytes
JWT_SECRET=your_jwt_signing_secret
ENCRYPTION_KEY=your_aes256_credential_encryption_key
CORS_ALLOWED_ORIGINS=https://jobs.example.com

# 3. N8N AUTOMATION ENGINE
N8N_BASE_URL=http://10.0.3.6:5678
N8N_SEARCH_WEBHOOK=http://10.0.3.6:5678/webhook/job-search
N8N_MANUAL_SEARCH_WEBHOOK=http://10.0.3.6:5678/webhook/manual-search
N8N_CSV_SEARCH_WEBHOOK=http://10.0.3.6:5678/webhook/csv-search
N8N_DOCUMENT_WEBHOOK=http://10.0.3.6:5678/webhook/generate-package
N8N_EMAIL_WEBHOOK=http://10.0.3.6:5678/webhook/send-email
N8N_TELEGRAM_CALLBACK_WEBHOOK=http://10.0.3.6:5678/webhook/telegram-callback
N8N_WEBHOOK_SECRET=your_webhook_signature_secret

# 4. GOOGLE WORKSPACE & DRIVE
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REFRESH_TOKEN=your_google_oauth_refresh_token
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_NAME=Job Search Assistant
GOOGLE_SHEETS_EXPORT_ID=your_export_spreadsheet_id

# 5. GMAIL & SMTP DISPATCH
EMAIL_PROVIDER=gmail # gmail | smtp | resend
EMAIL_SENDER_NAME="Alex Taylor"
EMAIL_SENDER_ADDRESS=alex.taylor@example.com
EMAIL_REPLY_TO=alex.taylor@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alex.taylor@example.com
SMTP_PASSWORD=your_app_specific_password
SMTP_SECURE=false

# 6. TELEGRAM BOT API
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=617149298
TELEGRAM_NOTIFICATION_ENABLED=true
TELEGRAM_ONE_BY_ONE_MODE=true
TELEGRAM_MIN_MATCH_SCORE=70

# 7. AI PROVIDER ABSTRACTION
AI_PROVIDER=openrouter # openrouter | openai | gemini | ollama
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
AI_MATCH_MODEL=deepseek/deepseek-v4-flash-0731:free
AI_RESUME_MODEL=anthropic/claude-3.5-sonnet
AI_COVER_LETTER_MODEL=anthropic/claude-3.5-sonnet
AI_RESEARCH_MODEL=meta-llama/llama-3.1-8b-instruct:free

# 8. SEARCH & JOB SOURCE APIS
SERPAPI_KEY=your_serpapi_key_for_google_jobs
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
JOOBLE_API_KEY=your_jooble_api_key

# 9. PDF & DOCX GENERATION SERVICE
PDF_RENDERER_URL=http://gotenberg:3000
PDF_STORAGE_DRIVER=local # local | s3 | gdrive
DOCX_TEMPLATE_PATH=./templates/ats-resume-template.docx

# 10. RATE LIMITING & OUTBOX CONTROLS
EMAIL_REQUIRE_APPROVAL=true
EMAIL_HOURLY_LIMIT=5
EMAIL_DAILY_LIMIT=20
EMAIL_SAME_COMPANY_COOLDOWN_HOURS=48
JOB_SEARCH_BATCH_SIZE=15
JOB_SEARCH_HOURLY_ENABLED=true

# 11. APPLICATION HOSTING
PORT=3000
HOSTNAME=0.0.3.3
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://jobs.example.com
