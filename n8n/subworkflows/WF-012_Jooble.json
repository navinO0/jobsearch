{
  "name": "WF-012-Jooble",
  "nodes": [
    {
      "parameters": {},
      "id": "subwf-trigger",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://jooble.org/api/{{ $env.JOOBLE_API_KEY || 'test' }}",
        "options": {
          "timeout": 12000,
          "followRedirects": true
        }
      },
      "id": "http-fetch",
      "name": "Fetch Source API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.first()?.json?.jobs || [];\nreturn items.map(j => ({\n  json: {\n    externalId: String(j.id),\n    sourceId: 'jooble',\n    sourceName: 'Jooble',\n    title: j.title,\n    companyName: j.company || 'Unknown',\n    location: j.location || 'Remote',\n    salaryMin: j.salary ? parseFloat(j.salary) : 0,\n    description: j.snippet || '',\n    applicationUrl: j.link,\n    postedAt: j.updated || new Date().toISOString()\n  }\n}));\n"
      },
      "id": "transform-code",
      "name": "Transform to Normalized Schema",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "Fetch Source API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Source API": {
      "main": [
        [
          {
            "node": "Transform to Normalized Schema",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1.0.0",
  "id": "wf-012-jooble"
}