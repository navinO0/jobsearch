{
  "name": "WF-011-Adzuna",
  "nodes": [
    {
      "parameters": {},
      "id": "subwf-trigger",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://api.adzuna.com/v1/api/jobs/us/search/1?app_id={{ $env.ADZUNA_APP_ID || '' }}&app_key={{ $env.ADZUNA_APP_KEY || '' }}&results_per_page=15&what={{ encodeURIComponent($json.query || 'developer') }}",
        "options": {
          "timeout": 12000,
          "followRedirects": true
        }
      },
      "id": "http-fetch",
      "name": "Fetch Source API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.first()?.json?.results || [];\nreturn items.map(j => ({\n  json: {\n    externalId: String(j.id),\n    sourceId: 'adzuna',\n    sourceName: 'Adzuna',\n    title: j.title,\n    companyName: j.company?.display_name || 'Unknown',\n    location: j.location?.display_name || 'Remote',\n    salaryMin: j.salary_min || 0,\n    salaryMax: j.salary_max || 0,\n    description: j.description || '',\n    applicationUrl: j.redirect_url,\n    postedAt: j.created || new Date().toISOString()\n  }\n}));\n"
      },
      "id": "transform-code",
      "name": "Transform to Normalized Schema",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    }
  ],
  "connections": {
