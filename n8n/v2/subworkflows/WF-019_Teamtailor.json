      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.first()?.json?.data || [];\nreturn items.slice(0, 15).map(j => ({\n  json: {\n    externalId: String(j.id),\n    sourceId: 'teamtailor',\n    sourceName: 'Teamtailor',\n    title: j.attributes?.title || 'Open Position',\n    companyName: 'Partner Company',\n    location: j.attributes?.location || 'Remote',\n    description: j.attributes?.body || '',\n    applicationUrl: j.links?.careersite_job_url,\n    postedAt: j.attributes?.['created-at'] || new Date().toISOString()\n  }\n}));\n"
      },
      "id": "transform-code",
      "name": "Transform to Normalized Schema",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    }
  ],
  "connections": {
